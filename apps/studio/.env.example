# Datos locales (BD SQLite y media). Ruta absoluta a la carpeta data/ del repositorio.
SANTISO_DATA_DIR=C:/ruta/al/repositorio/santiso/data

# Lectura de actas en foto, con IA. Opcional: la ficha federativa en PDF se lee en local y no
# usa ninguna de estas dos. Sin clave, el botón de Gemini falla y el resto del panel funciona.
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Solo para tools/migracion-supabase ---
# La aplicación ya no lee Supabase: estas dos variables las usa únicamente la herramienta de
# migración, que sigue existiendo por si hubiera que recuperar algún dato de la nube.
# Cuando se retire la herramienta, se borran con ella.
# ⚠️ La service role salta las reglas de acceso del proyecto. No la expongas nunca.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
